# 06 - Turtle-Grafik: vier Figuren in einer SVG-Datei
# Aufruf: java MiniForth beispiele/06-turtle.mf > turtle.svg

# >>> bibliothek/arith.mf
# Bibliothek arith.mf - Division und Rest, gebaut aus +, -, * und <
# Die Maschine kennt kein / und kein mod. Wir definieren beide selbst,
# mit denselben Regeln wie Java: Der Quotient wird zur Null hin abgeschnitten,
# der Rest hat das Vorzeichen des Dividenden.

: abs ( a -- b )   a 0 < if 0 a - else a then ;
: max ( a b -- m ) a b < if b else a then ;

# Schriftliche Division im Zweiersystem, fuer a >= 0 und b > 0:
# Erst a durch 2b teilen (rekursiv), dann pruefen, ob noch einmal b hineinpasst.
: udiv ( a b -- q )
    local q
    local r
    a b < if 0 else
    a b - b < if 1 else                  # b <= a < 2b
        a  b b +  udiv to q              # q = a / 2b
        a  q b b + *  -  to r            # r = a - q * 2b, also 0 <= r < 2b
        q q +  r b < if 0 else 1 then  +
    then then
;
: / ( a b -- q )
    b 0 = if "Division durch 0" .s 0 else
    a 0 <  b 0 <  =  if a abs b abs udiv else 0  a abs b abs udiv  - then then
;
: mod ( a b -- r )  a  a b / b *  - ;
# <<< bibliothek/arith.mf

# >>> bibliothek/trig.mf
# Bibliothek trig.mf - Sinus und Kosinus mit ganzen Zahlen
# Benoetigt arith.mf. Winkel in Grad mit beliebigem Vorzeichen,
# Ergebnis mal 10000: 45 sin liefert 7071 statt 0.7071.

: norm ( deg -- d )      # auf 0 ... 359 bringen
    deg 0 < if deg 360 + norm else deg 360 < if deg else deg 360 - norm then then
;

# Bhaskara I. (7. Jahrhundert), gueltig fuer 0 bis 180 Grad:
# sin x ~ 4x(180 - x) / (40500 - x(180 - x))
: bhaskara ( d -- s )
    local p
    d 180 d - * to p
    40000 p *  40500 p -  /
;

# Taylor-Polynom bis x^7 im Horner-Schema, gueltig fuer -90 bis 90 Grad:
# sin x ~ x (1 - x^2/6 (1 - x^2/20 (1 - x^2/42)))
# x ist der Winkel im Bogenmass, ebenfalls mal 10000 (pi = 31416).
: taylor7 ( d -- s )
    local x
    local x2
    local t
    d 31416 * 180 / to x
    x x * 10000 / to x2
    10000  x2 42 /  -  to t
    10000  x2 t * 10000 / 20 /  -  to t
    10000  x2 t * 10000 / 6 /  -  to t
    x t * 10000 /
;

class Trig                               # cos ist fuer alle Verfahren gleich
    : cos ( deg -- c )   deg 90 +  this send sin ;
end

class Bhaskara extends Trig
    : sin ( deg -- s )
        local d
        deg norm to d
        d 180 < if d bhaskara else 0  d 180 - bhaskara  - then
    ;
    : toString ( -- s )  "Bhaskara" ;
end

class Taylor extends Trig
    : sin ( deg -- s )
        local d
        deg norm to d
        d 91 < if d taylor7
        else d 271 < if 180 d - taylor7
        else d 360 - taylor7 then then
    ;
    : toString ( -- s )  "Taylor" ;
end
# <<< bibliothek/trig.mf

# >>> bibliothek/turtle.mf
# Bibliothek turtle.mf - Turtle-Grafik mit SVG-Ausgabe
# Benoetigt arith.mf und trig.mf. Koordinaten intern mal 10000, damit sich
# Rundungsfehler nicht aufsummieren.
#
# Ausgabetrick: Jedes str und concat legt einen Eintrag im String-Pool an
# (hoechstens 1023). Koordinaten werden deshalb nie zu Strings verbunden,
# sondern mit . als Zahl ausgegeben, jede auf einer eigenen Zeile. In einem
# SVG-Pfad ist ein Zeilenumbruch einfach Leerraum.

: round ( v -- p )   v 0 < if v 5000 - else v 5000 + then  10000 / ;

class Turtle
    field x
    field y
    field heading                          # Grad, 0 = nach rechts, positiv = links herum
    field trig                             # Bhaskara oder Taylor
    field pen
    : init ( x0 y0 t -- self )
        x0 10000 * to x  y0 10000 * to y  0 to heading  t to trig  1 to pen  this
    ;
    : point ( -- )      x round .  y round . ;
    : start ( color -- )                   # einen Pfad beginnen
        "<path fill='none' stroke='" color concat "' d='" concat .s
        "M" .s  this send point
    ;
    : finish ( -- )     "'/>" .s ;
    : up ( -- )         0 to pen ;
    : down ( -- )       1 to pen ;
    : turn ( deg -- )   heading deg + norm to heading ;    # -360 ... +360 und mehr
    : forward ( len -- )
        x  len heading trig send cos *  +  to x
        y  len heading trig send sin *  -  to y     # SVG: y waechst nach unten
        pen if "L" else "M" then .s  this send point
    ;
    : toString ( -- s )
        "Turtle bei " x round str concat "," concat y round str concat
        ", Richtung " concat heading str concat " Grad, " concat trig send toString concat
    ;
end

: svgOpen ( w h -- )
    "<svg xmlns='http://www.w3.org/2000/svg' width='" w str concat
    "' height='" concat h str concat "'>" concat .s
    "<rect width='100%' height='100%' fill='white'/>" .s
;
: svgClose ( -- )    "</svg>" .s ;
: label ( x y text -- )
    "<text x='" x str concat "' y='" concat y str concat
    "' font-family='sans-serif' font-size='16'>" concat text concat "</text>" concat .s
;
# <<< bibliothek/turtle.mf

: poly ( t k len ang -- )            # k-mal vorwaerts und drehen
    0 k < if  len t send forward  ang t send turn  t k 1 - len ang poly  then
;
: koch ( t len k -- )
    k 0 = if len t send forward else
        t len 3 / k 1 - koch    60 t send turn
        t len 3 / k 1 - koch  -120 t send turn
        t len 3 / k 1 - koch    60 t send turn
        t len 3 / k 1 - koch
    then
;
: snowflake ( t len k -- )
    t len k koch  -120 t send turn  t len k koch  -120 t send turn  t len k koch
;
: tree ( t len k -- )
    0 k < if
        len t send forward
         25 t send turn   t len 3 * 4 /  k 1 -  tree
        -50 t send turn   t len 3 * 4 /  k 1 -  tree
         25 t send turn
        0 len - t send forward                # zurueck zum Astansatz
    then
;
: rosette ( t k -- )   0 k < if  t 4 70 90 poly  10 t send turn  t k 1 - rosette  then ;
: spiral ( t len k -- ) 0 k < if  len t send forward  89 t send turn  t len 3 + k 1 - spiral  then ;

: demo ( -- )
    local t
    900 640 svgOpen

    40 100 new Bhaskara new Turtle send init to t
    "navy" t send start   t 243 4 snowflake   t send finish
    40 30 "Koch-Schneeflocke, Tiefe 4" label

    620 330 new Taylor new Turtle send init to t
    90 t send turn
    "darkgreen" t send start   t 70 8 tree   t send finish
    480 30 "Baum: Drehungen um +25 und -50 Grad" label

    170 480 new Bhaskara new Turtle send init to t
    "crimson" t send start   t 36 rosette   t send finish
    40 360 "Rosette: 36 Quadrate, je 10 Grad gedreht" label

    640 500 new Taylor new Turtle send init to t
    "darkorange" t send start   t 2 52 spiral   t send finish
    480 360 "Spirale: Drehung um 89 Grad" label

    svgClose
;
demo
